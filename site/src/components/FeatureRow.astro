---
const features = [
  {
    title: "Type-safe",
    body: "defineSurvey returns a typed Survey. Zod schemas per question. Branching is a TS function, not a DSL.",
  },
  {
    title: "Agent-friendly",
    body: "Pipe JSON via stdin. Schema introspectable. Validation errors structured. CI-ready.",
  },
  {
    title: "Open source",
    body: "MIT. No telemetry. No backend. Responses live on your disk.",
  },
];
---

<section class="container-shell py-block">
  <div class="grid gap-px border border-iron-gray/70 bg-iron-gray/70 md:grid-cols-3">
    {features.map((feature) => (
      <article class="bg-void-black p-6">
        <h3 class="font-display text-h3 font-bold text-pale-wraith">{feature.title}</h3>
        <div class="mt-3 h-px w-16 bg-ember-red"></div>
        <p class="mt-5 text-small text-frost-silver">{feature.body}</p>
      </article>
    ))}
  </div>
</section>
