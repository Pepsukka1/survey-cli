---
import Terminal from "./Terminal.astro";
---

<section class="dichotomy-split-hero border-b border-iron-gray/60">
  <div class="grid min-h-[calc(100vh-64px)] grid-cols-1 lg:grid-cols-[55fr_45fr]">
    <div class="flex items-center bg-ash-charcoal px-4 py-20 lg:px-0">
      <div class="mx-auto w-full max-w-[640px] lg:mr-12 lg:ml-auto">
        <div class="mb-5 flex items-center gap-3 text-micro font-medium tracking-[0.02em] text-silver-steel uppercase">
          <span class="wolf-eye-pulse" aria-hidden="true"></span>
          <span>@crafter/survey-cli · v0.0.1</span>
        </div>
        <h1 class="display-serif engraved-fill text-hero">Surveys, from your terminal.</h1>
        <p class="mt-6 max-w-[560px] text-balance text-lg leading-8 text-frost-silver">
          Type-safe, agent-friendly, open source. Define a survey in five lines. Run it interactively or pipe answers from an agent. No backend required.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <button class="ghost-button ember-glow-accent mono min-h-12" type="button" data-copy-command="bunx @crafter/survey-cli take onboarding">
            bunx @crafter/survey-cli take onboarding
          </button>
          <a class="ghost-button min-h-12" href="https://github.com/crafter-station/survey-cli">View on GitHub →</a>
        </div>
      </div>
    </div>
    <div class="swirl-flow-gradient flex items-center border-t border-iron-gray/60 px-4 py-16 lg:border-t-0 lg:border-l lg:px-10">
      <div class="mx-auto w-full max-w-[560px]">
        <Terminal />
      </div>
    </div>
  </div>
  <script>
    const buttons = document.querySelectorAll("[data-copy-command]");
    for (const button of buttons) {
      button.addEventListener("click", async () => {
        const command = button.getAttribute("data-copy-command") ?? "";
        await navigator.clipboard.writeText(command);
        const original = button.textContent;
        button.textContent = "copied";
        window.setTimeout(() => {
          button.textContent = original;
        }, 1100);
      });
    }
  </script>
</section>
